{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "DekernAI docs",
  "description": "Agentic payment controls: one layer that decides, orchestrates and operates every deposit and payout, under your rules.",
  "colors": {"primary": "#C2360F", "light": "#FF4A1F", "dark": "#C2360F"},
  "fonts": {"heading": {"family": "Space Grotesk", "weight": 600}, "body": {"family": "Inter", "weight": 400}},
  "favicon": "/favicon.svg",
  "logo": {"light": "/logo/light.svg", "dark": "/logo/dark.svg"},
  "api": {
    "playground": {"display": "interactive"},
    "examples": {"languages": ["curl", "python", "javascript", "go", "java", "csharp", "php", "ruby"]}
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {"group": "Get started", "pages": ["index", "quickstart", "sandbox", "authentication"]},
          {
            "group": "Guides",
            "pages": [
              "guides/agent-supplier-invoice",
              "guides/user-payouts",
              "guides/credit-deposits",
              "guides/handle-unknown",
              "guides/approve-escalations",
              "guides/kill-switch",
              "guides/shadow-to-auto"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/payment-intents",
              "concepts/decisions",
              "concepts/payment-states",
              "concepts/policies",
              "concepts/mandates",
              "concepts/exceptions",
              "concepts/deposits-and-reconciliation",
              "concepts/routing-and-failover",
              "concepts/audit-and-replay"
            ]
          },
          {"group": "Webhooks", "pages": ["webhooks/events", "webhooks/signatures", "webhooks/retries"]},
          {
            "group": "Errors and limits",
            "pages": ["api/errors", "limits/idempotency", "limits/rate-limits", "limits/versioning"]
          },
          {"group": "SDKs and tools", "pages": ["tools/sdks", "tools/try-it", "tools/postman-and-openapi"]},
          {"group": "Changelog", "pages": ["changelog"]}
        ]
      },
      {"tab": "API reference", "openapi": "api/openapi.json"}
    ]
  },
  "navbar": {
    "primary": {"type": "button", "label": "Request sandbox access", "href": "https://SITE_DOMAIN/access/"}
  },
  "footer": {"socials": {}}
}
