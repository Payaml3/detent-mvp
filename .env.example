# DekernAI settings (spec/10-security-and-deploy.md). Copy to .env for local development.
# Every setting the app reads is listed here. Never commit .env.
APP_ENV=dev                         # dev | test | demo | sandbox
BRAND_NAME=DekernAI                 # brand name (B-01); change in one place
DATABASE_URL=postgresql+psycopg://detent:detent@localhost:5432/detent
DEMO_ORG_ID=org_demo
DEMO_PASSWORD=change-me             # must be changed for demo and sandbox (startup refuses otherwise)
SESSION_SECRET=change-me            # must be changed for demo and sandbox
API_KEY_PEPPER=
CREDENTIALS_ENCRYPTION_KEY=         # Fernet key for rail credentials (RAL-09)
MANDATE_SIGNING_KEY_DEMO=           # HMAC key for demo mandates
WEBHOOK_SECRET_PEPPER=

# AI (M2). Confirm the provider's data terms before any client data is used.
ANTHROPIC_API_KEY=
AGENT_LLM=auto                   # auto: Claude API when ANTHROPIC_API_KEY is set, else recorded stand-in responses
AGENT_API_KEY=                   # the instruction agent's own sk_test_ key (bound to its mandate); seeded by `detent seed`
MODEL_AGENT=claude-sonnet-5-5
MODEL_LIGHT=claude-haiku-5-5
MODEL_EVAL_JUDGE=claude-opus-5-5
AI_DAILY_TOKEN_BUDGET=2000000

# Chains. Test networks only: startup refuses any chain ID outside 84532, 11155111, 31337,
# both in RAILS_CONFIG and as reported by each RPC endpoint. ALLOWED_CHAIN_IDS can narrow, never widen.
RAILS_CONFIG=fixtures/rails.yaml
ALLOWED_CHAIN_IDS=84532,11155111,31337
BASE_SEPOLIA_RPC_URL=               # via faultproxy in test/sandbox
ETH_SEPOLIA_RPC_URL=
LOCAL_EVM_RPC_URL=http://127.0.0.1:8545
TEST_WALLET_PRIVATE_KEY_BASE=       # testnet only, never mainnet funds
TEST_WALLET_PRIVATE_KEY_ETH=
TEST_WALLET_PRIVATE_KEY_LOCAL=      # local anvil only (make chain); generate one, fund it with anvil_setBalance and MockUSDC mint
USDC_ADDRESS_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS_ETH_SEPOLIA=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Simulated rails
BANKSIM_URL=http://localhost:8100
FAULTPROXY_URL=http://localhost:8200

# Email and sales (M8+)
EMAIL_PROVIDER=outbox               # outbox | <provider>
SALES_INBOX=

# Logs
LOG_LEVEL=INFO
LOG_JSON=true

# Worker
WORKER_ID=
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=8
WORKER_EXTRA_HANDLER_MODULES=       # tests only; rejected unless APP_ENV=test
