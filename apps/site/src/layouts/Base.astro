---
import "../styles/site.css";
import config from "../../site.config.mjs";
import { palettes, paletteCss } from "../styles/palettes.mjs";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props { title?: string; description: string; schema?: boolean; noindex?: boolean; }
const { title, description, schema = false, noindex = false } = Astro.props;
// Home title leads with the name, then the category and the rails searchers name (SEO/GEO audit, 2026-11-26).
const fullTitle = title
  ? `${title} · ${config.brandName} payment controls`
  : `${config.brandName}: ${config.category} for deposits and payouts on stablecoin and instant bank rails`;
const canonical = new URL(Astro.url.pathname, config.siteUrl).href;
const og = new URL("/og.jpg", config.siteUrl).href;
const logo = new URL("/icon-512.png", config.siteUrl).href;
const orgId = `${config.siteUrl}/#organization`;
// One linked graph: the organisation, the website and the product, so search and AI systems resolve one entity.
const jsonLd = schema ? [{
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": orgId, name: config.brandName, url: config.siteUrl, logo, description,
      areaServed: ["GB", "EU"] },
    { "@type": "WebSite", "@id": `${config.siteUrl}/#website`, name: config.brandName, url: config.siteUrl,
      inLanguage: "en-GB", publisher: { "@id": orgId } },
    { "@type": "SoftwareApplication", name: `${config.brandName} payment controls`, url: config.siteUrl,
      applicationCategory: "BusinessApplication", applicationSubCategory: config.category, operatingSystem: "Web",
      description, publisher: { "@id": orgId } },
  ],
}] : [];
const palette = palettes[config.palette];
---
<!doctype html>
<html lang="en-GB" data-palette={config.palette} data-scheme={palette.scheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || !config.indexable) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={palette.text} />
    <style is:inline set:html={paletteCss(config.palette)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.brandName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${config.brandName}: ${config.category}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import "../scripts/reveal.js";
      import "../scripts/cards.js";
    </script>
  </body>
</html>
