---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import config from "../../site.config.mjs";
---
<Base title="Cookie notice" description={`${config.brandName} Cookie notice (draft for legal review).`}>
  <PageHead title="Cookie notice" lead="Draft for legal review. This page is a template and is not yet in force." />
  <section class="section"><div class="wrap">
    <div class="legal">
      <p class="tag">Draft for legal review</p>
      <p>This website sets no cookies and loads no third-party trackers. If analytics are added, they will be cookie-less, and this notice will say which provider and what is measured.</p>
      <p class="soft">The final text will be published after legal review, before the sandbox opens.</p>
    </div>
  </div></section>
</Base>
<style>
  .legal { max-width: 64ch; display: grid; gap: 18px; font-size: 18px; }
  .tag { justify-self: start; background: rgba(242, 184, 75, 0.12); color: var(--amber); border-radius: 6px; padding: 6px 12px; font-weight: 600; font-size: 15px; }
</style>
