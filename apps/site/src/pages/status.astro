---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import config from "../../site.config.mjs";
import { COMPONENTS } from "../lib/status.mjs";
---
<Base title="Status" description={`Live status of the ${config.brandName} sandbox API, dashboard and docs, from health checks.`}>
  <PageHead title="Status." lead="Live health checks of the sandbox API, the dashboard and the docs. If a call fails and everything here is operational, the problem is likely on your side; if not, it's on ours." />
  <section class="section"><div class="wrap">
    <div class="status" data-status data-url={config.statusUrl} data-reveal>
      <p class="summary" data-summary aria-live="polite">Checking…</p>
      <ul>
        {COMPONENTS.map((c) => (
          <li data-component={c.id}><span class="name">{c.name}</span><span class="state" data-state="checking">Checking…</span></li>
        ))}
      </ul>
      <p class="soft small" data-checked>Checks refresh every minute.</p>
    </div>
  </div></section>
</Base>
<style>
  .status { max-width: 720px; display: grid; gap: 20px; background: var(--surface); border-radius: 14px; padding: 32px; }
  .summary { font-size: clamp(20px, 2vw, 26px); font-weight: 600; margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  li { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 18px; }
  .state { font-weight: 600; color: var(--text-soft); }
  .state[data-state="operational"] { color: var(--ok); }
  .state[data-state="down"], .state[data-state="unreachable"] { color: var(--danger); }
  .small { font-size: 15px; margin: 0; }
</style>
<script>
  import { statusRows } from "../lib/status.mjs";
  const box = document.querySelector<HTMLElement>("[data-status]");
  async function refresh() {
    if (!box) return;
    let body = null;
    try {
      const r = await fetch(box.dataset.url ?? "", { cache: "no-store" });
      body = await r.json();
    } catch { body = null; }
    const { rows, summary, checkedAt } = statusRows(body);
    box.querySelector("[data-summary]")!.textContent = summary;
    for (const row of rows) {
      const el = box.querySelector<HTMLElement>(`[data-component="${row.id}"] .state`);
      if (el) { el.textContent = row.label; el.dataset.state = row.state; }
    }
    const when = checkedAt ? new Date(checkedAt).toLocaleString() : null;
    box.querySelector("[data-checked]")!.textContent = when ? `Last checked ${when}. Checks refresh every minute.` : "Checks refresh every minute.";
  }
  refresh();
  setInterval(refresh, 60_000);
</script>
