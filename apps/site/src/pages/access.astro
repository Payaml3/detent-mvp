---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import config from "../../site.config.mjs";
const connected = !config.accessFormAction.startsWith("PLACEHOLDER");
---
<Base title="Request access" description={`Request access to ${config.brandName}: tell us about your platform and start onboarding.`}>
  <PageHead title="Request access." lead="Tell us about your platform and how you pay out today. You get an email straight away, and we reply with the next steps.">
    <Fragment slot="fragments">
      <div class="frag" data-ui data-reveal><p class="frag-title">Step 1 · NDA</p><p>A short mutual NDA, signed online before we talk in detail.</p></div>
      <div class="frag" data-ui data-reveal><p class="frag-title">Step 2 · Commercial call</p><p>A call and a demo on your rails, volumes and the rules you run today.</p></div>
      <div class="frag" data-ui data-reveal><p class="frag-title">Step 3 · Approval</p><p>If it’s a fit, your account owner gets a single-use invite to sign up.</p></div>
      <div class="frag" data-ui data-reveal><p class="frag-title">Step 4 · Sandbox and dashboard</p><p>Sandbox keys, rules, team roles and the console in one place.</p></div>
    </Fragment>
  </PageHead>
  <section class="section"><div class="wrap grid">
    <form class="form" data-reveal method="post" action={connected ? config.accessFormAction : undefined} data-access-form>
      {!connected && <p class="notice" role="note">This form isn’t connected yet. Nothing you type is sent. Email {config.salesInbox} instead.</p>}
      <label>Name<input name="name" autocomplete="name" required /></label>
      <label>Work email<input name="email" type="email" autocomplete="email" required /></label>
      <label>Job title<input name="title" autocomplete="organization-title" /></label>
      <label>Company<input name="company" autocomplete="organization" required /></label>
      <label>Country of incorporation<input name="country" autocomplete="country-name" required /></label>
      <label>Platform type
        <select name="platform">
          <option>Payout platform</option><option>Crypto service provider</option><option>Broker or prop firm</option><option>Marketplace</option><option>Other</option>
        </select>
      </label>
      <label>Rails you pay out on
        <select name="rails">
          <option>Stablecoins</option><option>Instant bank payouts</option><option>Both</option><option>Other</option>
        </select>
      </label>
      <label>How do you approve payouts today?<textarea name="message" rows="4"></textarea></label>
      <button class="button" type="submit">Request access</button>
      <p class="small soft">We use these details only to reply to your request and arrange a call. We don’t add you to a mailing list. <a class="textlink" href="/privacy/">How we handle your data</a></p>
    </form>
    <div class="aside" data-reveal>
      <h2>What happens next</h2>
      <ul>
        <li>We reply to book a discovery call and a demo.</li>
        <li>If we both want to go ahead, we run due diligence (KYB) on your business and sign the contract and data processing agreement.</li>
        <li>Once KYB is approved, your account owner gets a registration email, signs up and invites the team.</li>
        <li>Your rules are signed off by your compliance lead before any live payment is decided. You sign every step that moves money closer to being sent.</li>
      </ul>
      <p class="soft">There is no public sign-up. Every account starts with onboarding. <a class="textlink" href="/design-partners/">See the seven phases</a></p>
    </div>
  </div></section>
</Base>
<style>
  .grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; }
  .form { display: grid; gap: 18px; background: var(--surface); border-radius: 14px; padding: 32px; }
  label { display: grid; gap: 6px; font-weight: 500; }
  input, select, textarea { font: inherit; color: var(--text); background: var(--surface-sunk); border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; min-height: 48px; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--interactive-soft); outline-offset: 1px; }
  .notice { background: color-mix(in srgb, var(--wait) 12%, transparent); color: var(--wait); border-radius: 6px; padding: 10px 14px; font-size: 15px; }
  .aside { display: grid; gap: 20px; align-content: start; }
  .aside h2 { font-size: clamp(26px, 2.4vw, 36px); }
  .aside ul { margin: 0; padding-left: 20px; display: grid; gap: 10px; color: var(--text-soft); font-size: 18px; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
<script>
  const form = document.querySelector("[data-access-form]");
  if (form && !form.getAttribute("action")) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const note = form.querySelector(".notice");
      if (note) note.textContent = "This form isn’t connected yet, so nothing was sent. Email the sales inbox instead.";
    });
  }
</script>
