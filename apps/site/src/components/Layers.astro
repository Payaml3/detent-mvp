---
const layers = [
  {
    id: "decision", name: "Decision", question: "Should this payment happen?",
    body: "Execute, escalate or block every pay-in and payout under rules your compliance lead approved. Mandate, KYB, screening, travel rule, limits, daily caps and unusual-activity checks, each with its reason and evidence.",
    modules: ["Intent", "Mandate", "Decide", "Policy"],
    agentTitle: "Instruction agent",
    agent: "Proposed $18,500.00 USDC to Bluefin Components Ltd from INV-2026-0142. Network Base Sepolia, wallet matches the registry. No flags.",
    cite: "Every field quoted from the invoice; the rules decide.",
  },
  {
    id: "orchestration", name: "Orchestration", question: "How and where should it execute?",
    body: "Picks the best rail by policy, sends exactly once, fails over only on technical errors, and stops everything when the kill switch is on. A timeout becomes UNKNOWN, never FAILED.",
    modules: ["Route", "Execute", "Connect"],
    agentTitle: "Investigation agent",
    agent: "Attempt is UNKNOWN: the transaction is on chain with 1 of 3 confirmations. Nothing to resend; the resolver will confirm it.",
    cite: "Cites the receipt and the rail’s status; it can’t retry or approve.",
  },
  {
    id: "operations", name: "Operations", question: "How is it monitored, reconciled and proven?",
    body: "An exceptions queue with owners and deadlines, one ledger reconciled across rails, and an audit log where every payment replays to the decision it got.",
    modules: ["Exceptions", "Reconcile", "Prove"],
    agentTitle: "Reconciliation agent",
    agent: "Deposit of 200.00 USDC arrived on Ethereum Sepolia, expected on Base Sepolia. Proposed fix: match to the account’s open deposit intent.",
    cite: "A person approves the fix; it’s applied as a new ledger entry.",
  },
];
---
<section class="section layers" data-section="layers" aria-labelledby="layers-title">
  <div class="wrap">
    <div class="head" data-reveal>
      <h2 id="layers-title">Three layers. One payment ID.</h2>
      <p class="lead">AI agents do the work in every layer: they prepare intents, investigate escalations and draft reconciliation fixes. The rules make every decision.</p>
    </div>
    <div class="tabs" data-tabs data-reveal>
      <div class="tablist" role="tablist" aria-label="Layers">
        {layers.map((l, i) => (
          <button role="tab" id={`tab-${l.id}`} aria-controls={`panel-${l.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            <span class="tab-name">{l.name}</span><span class="tab-q">{l.question}</span>
          </button>
        ))}
      </div>
      {layers.map((l) => (
        <div class="panel" role="tabpanel" id={`panel-${l.id}`} aria-labelledby={`tab-${l.id}`} data-panel>
          <div class="copy">
            <h3>{l.question}</h3>
            <p>{l.body}</p>
            <p class="mods">{l.modules.join(" · ")}</p>
          </div>
          <div class="blueprint" data-ui aria-hidden="true">
            <svg viewBox="0 0 320 220" class={`plot plot-${l.id}`}>
              {l.id === "decision" && <g>
                <rect x="20" y="86" width="70" height="48" rx="4" /><text x="55" y="114">intent</text>
                <path d="M90 110 H130" /><rect x="130" y="70" width="80" height="80" rx="4" /><text x="170" y="114">policy</text>
                <path d="M210 90 L262 40" /><path d="M210 110 H262" /><path d="M210 130 L262 180" />
                <text x="268" y="44">execute</text><text x="268" y="114">escalate</text><text x="268" y="184">block</text>
              </g>}
              {l.id === "orchestration" && <g>
                <circle cx="60" cy="110" r="26" /><text x="60" y="114">send</text>
                <path d="M86 110 C140 110 140 50 196 50" /><path d="M86 110 H196" /><path d="M86 110 C140 110 140 170 196 170" />
                <rect x="196" y="34" width="100" height="32" rx="4" /><text x="246" y="54">Base Sepolia</text>
                <rect x="196" y="94" width="100" height="32" rx="4" /><text x="246" y="114">Eth Sepolia</text>
                <rect x="196" y="154" width="100" height="32" rx="4" /><text x="246" y="174">Instant bank</text>
              </g>}
              {l.id === "operations" && <g>
                <rect x="20" y="40" width="120" height="140" rx="4" /><text x="80" y="64">ledger</text>
                <path d="M36 88 H124" /><path d="M36 112 H124" /><path d="M36 136 H124" />
                <path d="M140 110 H180" /><rect x="180" y="40" width="120" height="140" rx="4" /><text x="240" y="64">rails</text>
                <path d="M196 88 H284" /><path d="M196 112 H284" /><path class="brk" d="M196 136 H284" /><text x="240" y="160">1 break</text>
              </g>}
            </svg>
          </div>
          <div class="agent" data-ui>
            <p class="agent-label"><span class="dot"></span>{l.agentTitle} · AI-generated, cited</p>
            <p class="agent-msg">{l.agent}</p>
            <p class="small soft">{l.cite}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .head { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; margin-bottom: 48px; }
  .head h2 { grid-column: 1 / span 6; } .head .lead { grid-column: 8 / span 5; align-self: end; color: var(--paper-soft); }
  .tablist { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 8px; }
  [role="tab"] { text-align: left; padding: 22px 24px; border: 0; border-radius: var(--radius); background: var(--ink-raised); color: var(--paper-soft);
    font: inherit; cursor: pointer; display: grid; gap: 4px; transition: background 200ms, color 200ms; }
  [role="tab"]:hover { color: var(--paper); }
  [role="tab"][aria-selected="true"] { background: #1F4FCC; color: var(--paper); }
  .tab-name { font: 600 24px/1.1 var(--font-head); letter-spacing: -0.02em; }
  .tab-q { font-size: 15px; }
  .panel[hidden] { display: none; }
  .panel { display: grid; grid-template-columns: 1.1fr 1fr 0.9fr; gap: 8px; margin-bottom: 8px; }
  .copy, .agent { background: var(--ink-raised); border-radius: var(--radius); padding: 32px; display: grid; gap: 16px; align-content: start; }
  .mods { color: var(--blue-soft); font-weight: 600; }
  .blueprint { border-radius: var(--radius); background: var(--blueprint);
    background-image: linear-gradient(rgba(255,255,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.07) 1px, transparent 1px); /* taste-skill-ignore: gradients allowed by founder decision D-19 */
    background-size: 24px 24px; display: grid; place-items: center; padding: 24px; min-height: 280px; }
  .plot { width: 100%; height: auto; }
  .plot rect, .plot circle { fill: rgba(255,255,255,.04); stroke: #CFE0FF; stroke-width: 1.4; }
  .plot path { fill: none; stroke: #CFE0FF; stroke-width: 1.4; stroke-dasharray: 400; stroke-dashoffset: 0; }
  .plot .brk { stroke: var(--orange); stroke-dasharray: 5 5; }
  .plot text { fill: #E6EEFF; font: 500 12px var(--font-body); text-anchor: middle; }
  .panel.drawing .plot path { animation: draw 900ms var(--ease-out) both; }
  @keyframes draw { from { stroke-dashoffset: 400; } }
  .agent { background: #121A31; border: 1px solid #2A4386; } /* taste-skill-ignore: inside a data-ui interface fragment */
  .agent-label { display: flex; align-items: center; gap: 8px; color: var(--blue-soft); font-size: 13px; font-weight: 600; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--blue-soft); }
  .agent-msg { font-size: 16px; line-height: 1.5; }
  @media (max-width: 1000px) { .head h2, .head .lead { grid-column: 1 / -1; } .panel { grid-template-columns: 1fr; } .tablist { grid-template-columns: 1fr; } }
</style>
<script>
  for (const root of document.querySelectorAll("[data-tabs]")) {
    const tabs = [...root.querySelectorAll('[role="tab"]')];
    const panels = [...root.querySelectorAll("[data-panel]")];
    const select = (i, focus) => {
      tabs.forEach((t, k) => { t.setAttribute("aria-selected", String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      panels.forEach((p, k) => { p.hidden = k !== i; p.classList.toggle("drawing", k === i); });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i, false));
      t.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowDown") { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (e.key === "ArrowLeft" || e.key === "ArrowUp") { e.preventDefault(); select((i + tabs.length - 1) % tabs.length, true); }
      });
    });
    select(0, false);
  }
</script>
