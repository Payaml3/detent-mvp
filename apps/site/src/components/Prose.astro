<div class="prose"><slot /></div>
<style>
  .prose { display: grid; grid-template-columns: minmax(200px, 34%) 1fr; gap: 24px 32px; }
  .prose :global(h2) { grid-column: 1; font-size: clamp(26px, 2.4vw, 36px); align-self: start; }
  .prose :global(.block) { grid-column: 2; display: grid; gap: 16px; max-width: 64ch; margin-bottom: 72px; }
  .prose :global(.block ul) { margin: 0; padding-left: 20px; display: grid; gap: 8px; }
  .prose :global(.block p), .prose :global(.block li) { font-size: 18px; }
  @media (max-width: 860px) { .prose { grid-template-columns: 1fr; } .prose :global(h2), .prose :global(.block) { grid-column: 1; } .prose :global(.block) { margin-bottom: 48px; } }
</style>
