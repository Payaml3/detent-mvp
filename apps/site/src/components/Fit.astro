---
import config from "../../site.config.mjs";
import Board from "./Board.astro";
// The payments board, then the questions buyers ask first. Who it's for lives in Platforms.astro, higher on the page.
const faq = [
  { q: `Does ${config.brandName} move or hold the money?`, a: `No. ${config.brandName} is agentic payment controls: it sits beside the rails and custody you already use, and your rules decide what they should do. It never holds client funds or keys.` },
  { q: "Does the AI approve payments?", a: "No. Agents prepare intents, investigate escalations and draft reconciliation fixes. Your rules make every decision, and a person approves anything the rules escalate." },
  { q: "Do we have to change the rails we use?", a: `No. ${config.brandName} works beside the rails and contracts you already have and tells them what to do. You add a control layer; you don’t move your money.` },
  { q: "Who approves a payment the rules escalate?", a: "A named person on your team, with the raw facts in front of them. The approver can never be the person who started the payment, and approving runs the rules again before anything is sent." },
  { q: "What happens if a rail times out?", a: "The payment becomes UNKNOWN, never FAILED, and nothing is resent until the rail’s own record shows what happened. That is how a timeout never turns into a second payment." },
  { q: "Which rails does it work with?", a: "It starts with rails that can’t be reversed: stablecoins and instant bank payouts." },
  { q: "How does onboarding work?", a: "Seven phases: discovery, contract and due diligence, sandbox integration, policy setup, shadow on your live traffic, go-live, then scale. In shadow every live payment is decided and nothing is sent, and you sign each move to Assist and then Auto." },
  { q: "What does it cost?", a: "A software fee per payment decided, never a share of the money you move. The Pilot covers integration to go-live on one rail. Talk to us about Pilot, Growth and Scale." },
];
---
<section class="section fit" aria-label="Payments board and questions">
  <div class="wrap">
    <Board />
    <div class="faq" data-section="faq">
      <h2 class="faq-title" data-reveal>Questions</h2>
      <div class="qs">
        {faq.map((f) => (
          <details data-reveal>
            <summary><span>{f.q}</span><span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  h2 { margin-bottom: 40px; max-width: 18ch; }
  .faq { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; margin-top: var(--section); }
  .faq-title { grid-column: 1 / span 4; }
  .qs { grid-column: 6 / span 7; display: grid; gap: 6px; align-content: start; }
  details { background: var(--surface); border-radius: var(--radius); padding: 0 24px; }
  details[open] { background: var(--surface-sunk); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 24px; padding: 22px 0; font: 600 clamp(19px, 1.5vw, 22px)/1.3 var(--font-head); letter-spacing: -0.01em; }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; flex: none; width: 16px; height: 16px; margin-top: 4px; }
  .plus::before, .plus::after { content: ""; position: absolute; left: 0; top: 7px; width: 16px; height: 2px; background: currentColor; transition: transform 200ms var(--ease-out); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0deg); }
  details p { padding: 0 0 24px; color: var(--text-soft); max-width: 60ch; }
  @media (max-width: 1000px) { .faq-title, .qs { grid-column: 1 / -1; } .faq-title { margin-bottom: 0; } }
</style>
