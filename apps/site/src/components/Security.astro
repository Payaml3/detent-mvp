---
const facts = [
  { label: "Custody", value: "Never holds client funds or keys in production. Signing stays with your custody provider." },
  { label: "Audit and replay", value: "Append-only, hash-chained log. Every payment replays to the decision it got, without calling a model." },
  { label: "Kill switch", value: "Stops every send, checked inside the lock. Only your payments lead releases it." },
  { label: "Hosting", value: "UK or EU cloud region, stated in the contract." },
];
const roadmap = ["SOC 2 Type I: planned", "Penetration test: planned", "Hardware-backed key vault: planned", "IP allowlists: planned"];
---
<section class="section security" data-section="security" aria-labelledby="sec-title">
  <div class="wrap">
    <div class="row">
      <h2 id="sec-title" data-reveal>Non-custodial by design.</h2>
      <p class="para" data-reveal>The controls sit beside your rails, never in the flow of funds. Your rules are versioned and need two approvers; a loosening change needs your compliance lead. Any error in a decision path holds the payment or sends it to your manual queue. Nothing executes unchecked.</p>
    </div>
    <div class="row facts">
      <dl>
        {facts.map((f) => <div data-reveal><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
      <div class="roadmap" data-reveal>
        <p class="rm-title">Roadmap</p>
        <ul>{roadmap.map((r) => <li>{r}</li>)}</ul>
        <a class="textlink" href="/security/">How security works</a>
      </div>
    </div>
  </div>
</section>
<style>
  .row { display: grid; grid-template-columns: minmax(200px, 34%) 1fr; gap: 32px; }
  .para { font: 400 clamp(20px, 1.7vw, 26px)/1.4 var(--font-body); max-width: 60ch; }
  .facts { margin-top: 72px; }
  dl { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; grid-column: 2; }
  dl div { background: var(--surface); border-radius: var(--radius); padding: 24px; display: grid; gap: 8px; }
  dt { font: 600 20px/1.2 var(--font-head); }
  dd { margin: 0; color: var(--text-soft); }
  .roadmap { grid-column: 1; grid-row: 1; display: grid; gap: 14px; align-content: start; }
  .rm-title { font-weight: 600; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; color: var(--text-soft); }
  @media (max-width: 900px) { .row { grid-template-columns: 1fr; } dl { grid-template-columns: 1fr; grid-column: 1; } .roadmap { grid-row: auto; } }
</style>
