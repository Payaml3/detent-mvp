---
const cases = [
  { name: "Payout platforms", line: "Creator and contractor payouts, each decided before it moves.", status: "EXECUTE", reason: "Routine payout within limits", amount: "€2,400.00 · SEPA Instant" },
  { name: "Crypto service providers", line: "Withdrawals to wallets you have never paid before are held, not guessed.", status: "ESCALATE", reason: "NEW_WALLET: first seen 2 days ago", amount: "300.00 USDC · Ethereum Sepolia" },
  { name: "Brokers and prop firms", line: "Trader payouts far above their history wait for a second look.", status: "ESCALATE", reason: "ABOVE_NORM: 4.1× the median", amount: "£4,100.00 · Faster Payments" },
  { name: "Marketplaces", line: "A seller who just changed bank details doesn’t get paid on autopilot.", status: "ESCALATE", reason: "CHANGED_DETAILS: 3 days ago", amount: "£820.00 · Faster Payments" },
];
---
<section class="section uses" data-section="use-cases" aria-labelledby="uses-title">
  <div class="wrap">
    <h2 id="uses-title" data-reveal>For platforms that hold user balances.</h2>
    <div class="stack">
      {cases.map((c, i) => (
        <details class="case" open={i === 0} data-reveal>
          <summary><span class="name">{c.name}</span></summary>
          <div class="body">
            <p class="line">{c.line}</p>
            <div class="readout" data-ui>
              <span class="small soft">Example decision</span>
              <span class={`chip st-${c.status === "EXECUTE" ? "CONFIRMED" : "ESCALATED"}`}>{c.status}</span>
              <span>{c.reason}</span>
              <span class="soft">{c.amount}</span>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  h2 { margin-bottom: 40px; }
  .stack { display: grid; gap: 8px; }
  .case { background: var(--surface); border-radius: var(--radius); overflow: hidden; transition: background 200ms; }
  .case[open] { background: var(--interactive-strong); color: var(--on-interactive); }
  .case[open] > summary .soft, .case[open] .line .soft { color: color-mix(in srgb, var(--on-interactive) 84%, var(--interactive-strong)); }
  summary { list-style: none; cursor: pointer; padding: 24px 32px; }
  summary::-webkit-details-marker { display: none; }
  .name { font: 600 clamp(36px, 5.4vw, 84px)/1 var(--font-head); letter-spacing: -0.04em; display: block; transition: transform 300ms var(--ease-out); }
  summary:hover .name { transform: translateX(8px); }
  .body { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 0 32px 32px; align-items: end; }
  .line { font-size: var(--t-lead); max-width: 34ch; }
  .readout { background: color-mix(in srgb, var(--bg) 55%, transparent); border-radius: 8px; padding: 16px 18px; display: grid; grid-template-columns: auto auto 1fr; gap: 6px 12px; align-items: center; }
  .case[open] .readout { background: var(--surface); color: var(--text); }
  .readout > :first-child { grid-column: 1 / -1; }
  .readout > :last-child { grid-column: 1 / -1; }
  @media (max-width: 800px) { .body { grid-template-columns: 1fr; } summary, .body { padding-left: 20px; padding-right: 20px; } }
</style>
