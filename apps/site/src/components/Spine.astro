---
import { PAYMENT_ID } from "../scripts/scenarios.mjs";
import Mark from "./Mark.astro";
// Landing UX §3.3: one payment's life through the three layers, the brand story's "sift, settle, prove".
// Replaces "How it works" and "Three layers" on the home page; "Agents prepare. Your rules decide." is said here once.
const layers = [
  { word: "Sift", name: "Decision", question: "Should this payment happen?",
    rules: "Your rules execute, escalate or block it. A block is final.",
    agent: "Prepares the payment intent from the invoice or request.", status: "ESCALATED" },
  { word: "Settle", name: "Orchestration", question: "How and where does it go?",
    rules: "Best rail by your policy, sent exactly once. A timeout is UNKNOWN, never resent.",
    agent: "Investigates an UNKNOWN result against the rail’s own record.", status: "SUBMITTED" },
  { word: "Prove", name: "Operations", question: "Can you show what happened?",
    rules: "Every outcome reconciled across rails and written to an append-only audit log.",
    agent: "Drafts the reconciliation fix for a person to accept.", status: "CONFIRMED" },
];
---
<section class="section spine" id="how-it-works" data-section="spine" aria-labelledby="spine-title">
  <div class="wrap">
    <div class="head" data-reveal>
      <h2 id="spine-title">Sift. Settle. Prove.</h2>
      <p class="statement"><Mark size={28} /> <span>Agents prepare. <strong>Your rules decide.</strong></span></p>
    </div>
    <p class="pid-row small soft" data-reveal>One payment ID for life: <span class="mono">{PAYMENT_ID}</span></p>
    <ol class="cols">
      {layers.map((l, i) => (
        <li class="col" data-reveal style={`--d:${i * 90}ms`}>
          <p class="step"><span class="word">{l.word}</span><span class="soft small">{l.name}</span></p>
          <h3>{l.question}</h3>
          <dl>
            <div><dt>Your rules</dt><dd>{l.rules}</dd></div>
            <div><dt>Agents do the groundwork</dt><dd>{l.agent}</dd></div>
          </dl>
          <p class="state" data-ui><span class={`chip st-${l.status}`}>{l.status}</span></p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .head { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: end; margin-bottom: 20px; }
  .head h2 { grid-column: 1 / span 6; }
  .statement { grid-column: 7 / span 6; display: flex; gap: 14px; align-items: center; font: 500 clamp(22px, 2.1vw, 32px)/1.25 var(--font-head); letter-spacing: -0.01em; }
  .statement strong { color: var(--signal); font-weight: 600; }
  .statement :global(.mark) { color: var(--text); flex: none; }
  .pid-row { margin-bottom: 40px; }
  .pid-row .mono { font-family: var(--font-mono); font-size: 13px; color: var(--text); }
  .cols { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 2px solid var(--text); }
  .col { position: relative; padding: 28px 28px 32px 0; display: grid; gap: 18px; align-content: start; }
  .col + .col { padding-left: 28px; border-left: 1px solid var(--line); }
  .step { display: flex; gap: 10px; align-items: baseline; }
  .word { font: 600 14px/1 var(--font-head); text-transform: uppercase; letter-spacing: 0.1em; color: var(--signal); }
  h3 { font-size: clamp(24px, 2.2vw, 32px); letter-spacing: -0.02em; }
  dl { margin: 0; display: grid; gap: 14px; }
  dt { font-size: var(--t-small); font-weight: 600; color: var(--text-soft); margin-bottom: 2px; }
  dd { margin: 0; }
  @media (max-width: 900px) {
    .head h2, .statement { grid-column: 1 / -1; }
    .cols { grid-template-columns: 1fr; }
    .col, .col + .col { padding: 24px 0; border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
