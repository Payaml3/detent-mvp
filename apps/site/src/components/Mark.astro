---
// The brand mark, "sift then settle" (B-01): many inputs above a rule, one settled outcome below it.
// Five dots, then three, cross the rule; one dot settles in the --settle colour.
interface Props { size?: number; }
const { size = 22 } = Astro.props;
---
<svg class="mark" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
  <g fill="currentColor">
    <circle cx="3.5" cy="4" r="1.6" /><circle cx="8.25" cy="4" r="1.6" /><circle cx="12" cy="4" r="1.6" /><circle cx="15.75" cy="4" r="1.6" /><circle cx="20.5" cy="4" r="1.6" />
    <circle cx="7.5" cy="10" r="1.7" /><circle cx="12" cy="10" r="1.7" /><circle cx="16.5" cy="10" r="1.7" />
  </g>
  <rect x="2" y="14" width="20" height="1.6" fill="currentColor" />
  <circle cx="12" cy="20" r="2.9" fill="var(--settle)" />
</svg>
