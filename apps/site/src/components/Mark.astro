---
// The brand mark, the "settled D": a D monogram with one point resting in its counter, the one
// outcome the rules settle on. The D takes currentColor; the point is --settle (safety orange).
// Rules and lockups: docs/brand/logo.md and apps/site/public/brand/.
interface Props { size?: number; }
const { size = 22 } = Astro.props;
---
<svg class="mark" viewBox="0 0 48 48" width={size} height={size} aria-hidden="true">
  <path fill="currentColor" fill-rule="evenodd" d="M5 4H23A20 20 0 0 1 23 44H5Z M13 12V36H23A12 12 0 0 0 23 12Z" />
  <circle cx="22" cy="30.5" r="5.5" fill="var(--settle)" />
</svg>
