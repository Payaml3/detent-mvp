---
const problems = [
  { name: "Review queues that never empty", body: "Static rules flag too much, so people check payments one by one, and the risky ones wait in the same line as the routine ones." },
  { name: "Deposits credited to the wrong account", body: "Wrong network, wrong reference, a duplicate notification: each one is a credit someone has to unwind by hand." },
  { name: "Retries that become second payments", body: "A timeout looks like a failure, the job retries, and the supplier is paid twice on a rail that won’t give it back." },
  { name: "Rails that can’t be reversed", body: "Stablecoins and instant bank payouts settle in seconds. A wrong decision is final the moment it’s sent." },
];
---
<section class="section problem" data-section="problem" aria-labelledby="problem-title">
  <div class="wrap grid">
    <div class="head" data-reveal>
      <h2 id="problem-title">Rails move money. Decisions stay yours.</h2>
      <p class="lead soft-lead">Platforms that hold user balances get rails from their providers and keep every decision themselves: credit this deposit, send this payout, which rail, how to reconcile.</p>
    </div>
    <ol class="list">
      {problems.map((p) => (
        <li data-reveal>
          <h3>{p.name}</h3>
          <p>{p.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; }
  .head { grid-column: 1 / span 5; display: grid; gap: 28px; align-content: start; position: sticky; top: 120px; }
  .soft-lead { color: var(--paper-soft); }
  .list { grid-column: 7 / span 6; list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .list li { background: var(--ink-raised); border-radius: var(--radius); padding: 32px; display: grid; gap: 12px; transition: background 200ms; }
  .list li:hover { background: #18233F; }
  .list h3 { font-size: clamp(24px, 2.2vw, 32px); letter-spacing: -0.02em; }
  @media (max-width: 900px) { .head, .list { grid-column: 1 / -1; position: static; } }
</style>
