---
import config from "../../site.config.mjs";
import { PAYMENT_ID } from "../scripts/scenarios.mjs";
// Landing UX (docs/design/landing-page-ux.md §3.1): headline A, the category line, the shadow report as the
// primary action, the example payment played layer by layer, and the "sift then settle" art (Q2: replaces
// the D-21 AI-agent figure, so the first screen shows the rules deciding). Final state shows without script.
const phases = [
  { layer: "decision", agent: "Agent prepared $18,500.00 USDC to Bluefin Components Ltd (fictional), from invoice INV-2026-0142.", status: "ESCALATED", rule: "Your rules: escalate. First payment, above the $10,000 auto limit." },
  { layer: "decision", agent: "Sam, the reviewer, read the raw facts and approved with a reason.", status: "READY", rule: "Your rules ran again on the active version: execute." },
  { layer: "orchestration", agent: "Best rail by policy: Base Sepolia (testnet). Sent once.", status: "SUBMITTED", rule: "One attempt in flight. Payment ID unchanged." },
  { layer: "orchestration", agent: "The rail’s answer was lost. Agent found the transaction on chain, awaiting confirmations.", status: "UNKNOWN", rule: "A timeout is UNKNOWN, never FAILED. Nothing is resent." },
  { layer: "orchestration", agent: "Receipt found after 3 confirmations.", status: "CONFIRMED", rule: "Transfers on the rail: 1." },
  { layer: "operations", agent: "Agent matched the ledger posting to the chain transfer.", status: "CONFIRMED", rule: "Audit chain verified. The payment replays to its decision." },
];
const cards = [
  { id: "decision", word: "Sift", name: "Decision", question: "Should this payment happen?" },
  { id: "orchestration", word: "Settle", name: "Orchestration", question: "How and where does it go?" },
  { id: "operations", word: "Prove", name: "Operations", question: "Can you show what happened?" },
];
const finalFor = (id) => [...phases].reverse().find((p) => p.layer === id);
const category = config.category.charAt(0).toUpperCase() + config.category.slice(1);
---
<section class="hero" data-section="hero" aria-labelledby="hero-title">
  <canvas class="art" aria-hidden="true" data-hero-sift></canvas>
  <div class="wrap hero-grid">
    <div class="intro">
      <h1 id="hero-title" class="headline">
        <span class="line"><span>Every deposit and payout,</span></span>
        <span class="line"><span>decided by your rules.</span></span>
      </h1>
      <p class="lead" data-reveal>{category}: one layer that decides, orchestrates and operates every deposit and payout, under your rules.</p>
      <div class="actions" data-reveal>
        <a class="button" href="#shadow-report">Get a free shadow report</a> {/* taste-skill-ignore: "shadow report" is a product name */}
        <a class="button secondary" href={config.bookingUrl}>Book a demo</a>
      </div>
      <p class="honesty small" data-reveal>Prototype · test networks only · never holds your funds or keys</p>
    </div>
    <div class="cards" data-ui data-hero-cards aria-label="Example payment, step by step">
      <p class="card-top"><span class="small soft">Example payment</span><span class="mono pid">{PAYMENT_ID}</span></p>
      {cards.map((c) => {
        const f = finalFor(c.id);
        return (
          <article class="card" data-card={c.id}>
            <p class="card-name"><span class="word">{c.word}</span><span class="soft">{c.name}</span></p>
            <h2 class="card-q">{c.question}</h2>
            <p class="card-agent"><span class="agent-dot" aria-hidden="true"></span><span data-agent-line>{f.agent}</span></p>
            <p class="card-rule"><span class={`chip st-${f.status}`} data-chip>{f.status}</span><span data-rule-line>{f.rule}</span></p>
          </article>
        );
      })}
      <p class="small soft foot">Fictional supplier, test network.</p>
    </div>
  </div>
  <script type="application/json" data-hero-phases set:html={JSON.stringify(phases)} />
</section>

<style>
  .hero { position: relative; min-height: max(760px, 100svh); overflow: hidden; background: var(--bg); }
  .art { position: absolute; left: 49%; top: 4%; width: 24%; height: 86%; pointer-events: none; }
  .hero-grid { position: relative; z-index: 2; min-height: max(760px, 100svh); display: grid; grid-template-columns: repeat(12, 1fr);
    column-gap: 24px; padding-top: 136px; padding-bottom: 56px; pointer-events: none; }
  .hero-grid > * { pointer-events: auto; }
  .intro { grid-column: 1 / span 7; display: grid; gap: 28px; align-content: start; }
  .headline { font-size: clamp(40px, 4.1vw, 68px); line-height: 1; }
  .line > span { white-space: nowrap; }
  .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .line > span { display: inline-block; animation: rise 900ms var(--ease-out) both; }
  .line:nth-child(2) > span { animation-delay: 110ms; }
  @keyframes rise { from { transform: translateY(105%); } }
  .lead { max-width: 36ch; color: var(--text-soft); }
  .actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .honesty { color: var(--text-soft); letter-spacing: 0.01em; }
  .cards { grid-column: 9 / span 4; align-self: center; display: grid; gap: 8px; }
  .card-top { display: grid; gap: 2px; padding: 0 4px 4px; }
  .pid { color: var(--text-soft); word-break: break-all; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; display: grid; gap: 8px; /* taste-skill-ignore: inside a data-ui interface fragment */
    transition: border-color 300ms, transform 300ms var(--ease-out), opacity 300ms; }
  .card.active { border-color: var(--interactive); transform: translateX(-6px); }
  .card-name { display: flex; gap: 8px; align-items: baseline; font-size: 12px; font-weight: 600; letter-spacing: 0.01em; }
  .word { color: var(--signal); font: 600 15px/1 var(--font-head); }
  .card-q { font: 600 18px/1.2 var(--font-head); letter-spacing: -0.01em; }
  .card-agent { display: grid; grid-template-columns: 10px 1fr; gap: 8px; align-items: start; color: var(--text); }
  .agent-dot { width: 8px; height: 8px; margin-top: 6px; border-radius: 50%; background: var(--text-soft); }
  .card-rule { display: grid; gap: 6px; justify-items: start; color: var(--text-soft); }
  .foot { padding: 4px; }
  @media (max-width: 1100px) {
    .art { left: 46%; width: 54%; height: 60%; top: 8%; opacity: 0.5; }
    .intro { grid-column: 1 / span 9; }
    .cards { grid-column: 1 / span 8; margin-top: 64px; align-self: start; }
  }
  @media (max-width: 680px) {
    .art { display: none; }
    .hero-grid { padding-top: 112px; }
    .intro, .cards { grid-column: 1 / -1; }
    .headline { font-size: clamp(28px, 7.8vw, 52px); }
    .line, .line > span { display: inline; animation: none; white-space: normal; }
    .line + .line::before { content: " "; }
    .actions .button { width: 100%; justify-content: center; }
    .cards { margin-top: 48px; }
  }
</style>

<script>
  const root = document.querySelector("[data-hero-cards]");
  const phases = JSON.parse(document.querySelector("[data-hero-phases]").textContent);
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cards = Object.fromEntries([...root.querySelectorAll("[data-card]")].map((c) => [c.dataset.card, c]));
  let sift = null;
  const canvas = document.querySelector("[data-hero-sift]");
  if (canvas && getComputedStyle(canvas).display !== "none") import("../scripts/sift.js").then(({ mountSift }) => { sift = mountSift(canvas); sift?.setState(phases.at(-1).status, true); });
  else canvas?.remove();
  const show = (i) => {
    const p = phases[i];
    for (const [id, card] of Object.entries(cards)) {
      card.classList.toggle("active", id === p.layer);
      const latest = [...phases.slice(0, i + 1)].reverse().find((x) => x.layer === id);
      card.style.opacity = latest ? "1" : "0.6";
      if (!latest) continue;
      card.querySelector("[data-agent-line]").textContent = latest.agent;
      card.querySelector("[data-rule-line]").textContent = latest.rule;
      const chip = card.querySelector("[data-chip]");
      chip.textContent = latest.status;
      chip.className = `chip st-${latest.status}`;
    }
    sift?.setState(p.status, p.status === "CONFIRMED");
  };
  if (!reduce) {
    let i = 0;
    const tick = () => { show(i); const last = i === phases.length - 1; i = last ? 0 : i + 1; setTimeout(tick, last ? 5200 : 2600); };
    tick();
  }
</script>
