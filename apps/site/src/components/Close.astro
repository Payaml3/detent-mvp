---
---
<section class="close" data-section="close" aria-labelledby="close-title">
  <div class="wrap inner">
    <h2 id="close-title" data-reveal>Held until it’s right.<br />Sent exactly once.</h2>
    <div class="foot" data-reveal>
      <p>Onboarding runs in seven phases, and you sign every step that moves money closer to being sent.</p>
      <div class="acts">
        <a class="button" href="/access/">Request access</a>
        <a class="button secondary dark" href="/design-partners/">How onboarding works</a>
      </div>
    </div>
  </div>
</section>
<style>
  .close { margin-top: var(--section); background: var(--text); color: var(--bg); display: flex; }
  .inner { display: grid; gap: clamp(64px, 10vw, 160px); padding-top: 120px; padding-bottom: 56px; }
  h2 { font-size: clamp(28px, 8.4vw, 136px); line-height: 0.92; letter-spacing: -0.045em; }
  @media (max-width: 680px) { h2 { font-size: 7.4vw; } }
  .foot { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; }
  .foot p { font-size: 20px; max-width: 46ch; }
  .acts { display: flex; gap: 12px; flex-wrap: wrap; }
  .secondary.dark { color: var(--bg); border-color: var(--bg); }
  .secondary.dark:hover { background: color-mix(in srgb, var(--bg) 12%, transparent); }
  @media (max-width: 680px) { .acts, .foot .button { width: 100%; justify-content: center; } }
</style>
