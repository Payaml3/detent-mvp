---
import { readResults } from "../lib/results.mjs";
// The results file appears once the evaluation suites run (EVL-06). Until then the section says so.
const files = import.meta.glob("../data/results.json", { eager: true, import: "default" });
const results = readResults(Object.values(files)[0] ?? null);
const gate = [
  { value: "0", caption: "unauthorised executions allowed across 100+ attack scenarios, prompt injection included" },
  { value: "0", caption: "duplicate payments allowed across 30+ fault cases; every retry keeps the payment ID" },
  { value: "10/10", caption: "runs of the $18,500 invoice must give the same correct intent" },
  { value: "99%", caption: "of deposits and payouts must match automatically, each break with a proposed fix" },
];
---
<section class="section results" data-section="results" aria-labelledby="results-title">
  <div class="wrap grid">
    <div class="head" data-reveal>
      <h2 id="results-title">Measured, dated, on test networks.</h2>
      {results.published ? (
        <p class="lead">{results.label}</p>
      ) : (
        <p class="lead">Results are not yet published. The first test-network evaluation runs before launch, and every figure will carry its date and the label “test-network evaluation on synthetic data”.</p>
      )}
    </div>
    {results.published ? (
      <dl class="ledger">
        {results.figures.map((f) => <div data-figure data-card><dt>{f.value}</dt><dd>{f.caption}</dd></div>)}
      </dl>
    ) : (
      <div class="gate">
        <p class="gate-title" data-reveal>What every release must pass before it ships:</p>
        <dl class="ledger">
          {gate.map((g) => <div data-card><dt>{g.value}</dt><dd>{g.caption}</dd></div>)}
        </dl>
        <p class="small soft" data-reveal>These are release-gate thresholds, not results.</p>
      </div>
    )}
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; }
  .head { grid-column: 1 / span 5; display: grid; gap: 24px; align-content: center; }
  .head .lead { color: var(--text-soft); }
  .gate { grid-column: 7 / span 6; display: grid; gap: 20px; }
  .gate-title { font-weight: 600; }
  .ledger { margin: 0; display: grid; gap: 8px; }
  .ledger div { display: grid; grid-template-columns: minmax(250px, 1fr) 1.5fr; align-items: baseline; gap: 24px; background: var(--surface); border-radius: var(--radius); padding: 22px 28px; }
  .ledger dt { font: 600 clamp(48px, 5vw, 84px)/1 var(--font-head); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; color: var(--text); text-align: right; }
  .ledger dd { margin: 0; font-size: 17px; }
  @media (max-width: 900px) { .head, .gate { grid-column: 1 / -1; } .ledger div { grid-template-columns: 1fr; gap: 8px; } .ledger dt { text-align: left; } }
</style>
