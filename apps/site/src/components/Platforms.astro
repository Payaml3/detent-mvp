---
import UseCases from "./UseCases.astro";
// Who it's for, right after the three layers: one platform at a time, run through decision, orchestration
// and operations, with the rails orchestration can choose between.
---
<section class="section platforms" data-section="use-cases" aria-labelledby="uses-title">
  <div class="wrap">
    <div class="uc-head">
      <h2 id="uses-title" data-reveal>For every platform that holds user balances.</h2>
      <p class="lead soft" data-reveal>Pick a platform and watch its process run: the agent prepares the payment, your rules decide it, orchestration picks the best rail with alternatives ready, and operations reconciles and records it.</p>
    </div>
    <UseCases />
  </div>
</section>
<style>
  .uc-head { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: end; margin-bottom: 40px; }
  .uc-head h2 { grid-column: 1 / span 6; margin: 0; max-width: 18ch; }
  .uc-head .lead { grid-column: 8 / span 5; margin: 0; }
  @media (max-width: 1000px) { .uc-head h2, .uc-head .lead { grid-column: 1 / -1; } }
</style>
