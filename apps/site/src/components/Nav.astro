---
import config from "../../site.config.mjs";
import Logo from "./Logo.astro";
const links = [
  { href: "/product/", label: "Product" },
  { href: "/#solutions", label: "Solutions" },
  { href: "/security/", label: "Security" },
  { href: config.docsUrl, label: "Developers" },  // the developer docs portal (founder, 2026-11-28)
  { href: "/design-partners/", label: "Onboarding" },
];
const here = Astro.url.pathname;
---
<header class="nav">
  <div class="wrap nav-row">
    <a class="wordmark" href="/" aria-label={`${config.brandName} home`}>
      <Logo height={26} />
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href} aria-current={here === l.href ? "page" : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav-actions">
      <a class="nav-signin" href={config.signInUrl}>Sign in</a>
      <a class="button nav-cta" href="/access/">Request access</a>
    </div>
  </div>
</header>
<style>
  .nav { position: absolute; inset: 0 0 auto 0; z-index: 20; }
  .nav-row { display: flex; align-items: center; gap: 32px; height: 84px; }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font: 700 21px/1 var(--font-head); letter-spacing: -0.02em; }
  nav { margin-left: auto; }
  ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--text-soft); text-decoration: none; font-size: 15px; font-weight: 500; transition: color 160ms; }
  nav a:hover, nav a[aria-current] { color: var(--text); }
  /* Sign in is quiet text; Request access stays the one filled button (there is no public sign-up). */
  .nav-actions { display: flex; align-items: center; gap: 20px; }
  .nav-signin, .nav-cta { white-space: nowrap; }
  .nav-signin { display: inline-flex; align-items: center; min-height: 44px; color: var(--text); text-decoration: none; font-size: 15px; font-weight: 500; }
  .nav-signin:hover { text-decoration: underline; text-underline-offset: 4px; }
  .nav-cta { min-height: 44px; padding: 0 18px; font-size: 15px; }
  @media (max-width: 860px) { nav { display: none; } .nav-actions { margin-left: auto; } }
  @media (max-width: 420px) { .nav-row { gap: 12px; } .nav-actions { gap: 12px; } .nav-signin { font-size: 14px; } .nav-cta { padding: 0 12px; font-size: 14px; } }
</style>
