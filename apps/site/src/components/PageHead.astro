---
interface Props { title: string; lead: string; }
const { title, lead } = Astro.props;
---
<section class="pagehead" aria-labelledby="page-title">
  <div class="dots" aria-hidden="true"></div>
  <div class="wrap inner">
    <h1 id="page-title" data-reveal>{title}</h1>
    <p class="lead" data-reveal>{lead}</p>
    <slot />
    {Astro.slots.has("fragments") && <div class="fragments"><slot name="fragments" /></div>}
  </div>
</section>
<style>
  .pagehead { position: relative; overflow: hidden; padding: 180px 0 80px; background:
    radial-gradient(60% 70% at 80% 20%, color-mix(in srgb, var(--interactive) 26%, transparent), transparent 70%), var(--bg); } /* taste-skill-ignore: gradients allowed by founder decision D-19 */
  .dots { position: absolute; inset: 0; opacity: 0.45; pointer-events: none;
    background-image: radial-gradient(color-mix(in srgb, var(--interactive-soft) 40%, transparent) 1px, transparent 1.4px); background-size: 14px 14px; /* taste-skill-ignore: gradients allowed by founder decision D-19 */
    -webkit-mask-image: radial-gradient(45% 60% at 82% 25%, #000, transparent 75%); mask-image: radial-gradient(45% 60% at 82% 25%, #000, transparent 75%); } /* taste-skill-ignore: gradients allowed by founder decision D-19 */
  .inner { position: relative; display: grid; gap: 28px; align-content: start;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); column-gap: 40px; }
  .inner > :not(.fragments) { grid-column: 1; }
  h1 { font-size: clamp(34px, 4.3vw, 70px); }
  .lead { color: var(--text-soft); max-width: 52ch; }
  .fragments { grid-column: 2; grid-row: 1 / span 4; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; align-self: start; }
  .fragments :global(.frag) { background: color-mix(in srgb, var(--surface) 92%, transparent); border-radius: var(--radius); padding: 18px; display: grid; gap: 10px;
    align-content: start; font-size: 15px; min-height: 210px; }
  .fragments :global(.frag-title) { color: var(--interactive-soft); font-size: 13px; font-weight: 600; }
  .fragments :global(.row) { display: flex; justify-content: space-between; gap: 10px; }
  @media (max-width: 1000px) { .inner { grid-template-columns: 1fr; } .fragments { grid-column: 1; grid-row: auto; margin-top: 24px; } }
  @media (max-width: 560px) { .fragments { grid-template-columns: 1fr; } .fragments :global(.frag) { min-height: 0; } }
</style>
